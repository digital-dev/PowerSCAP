<!-- Light: the same roles as Dark.xaml on white surfaces. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#F4F7F8"/>
    <SolidColorBrush x:Key="Rail" Color="#E9EFF1"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F0F4F5"/>
    <SolidColorBrush x:Key="Hover" Color="#E2EBEE"/>
    <SolidColorBrush x:Key="Line" Color="#D3DDE1"/>
    <SolidColorBrush x:Key="Text" Color="#132027"/>
    <SolidColorBrush x:Key="TextDim" Color="#55666F"/>
    <SolidColorBrush x:Key="Accent" Color="#0D9488"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0F766E"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#D5F2EE"/>
    <SolidColorBrush x:Key="Pass" Color="#15803D"/>
    <SolidColorBrush x:Key="PassSoft" Color="#DCF5E4"/>
    <SolidColorBrush x:Key="Warn" Color="#B45309"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FCEFD6"/>
    <SolidColorBrush x:Key="Fail" Color="#C81E1E"/>
    <SolidColorBrush x:Key="FailSoft" Color="#FBE1E1"/>
    <SolidColorBrush x:Key="Neutral" Color="#64748B"/>
    <SolidColorBrush x:Key="NeutralSoft" Color="#E6ECEF"/>
    <SolidColorBrush x:Key="Selection" Color="#CDEFEA"/>
</ResourceDictionary>
