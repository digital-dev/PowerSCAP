<!-- Dark "security console": near-black surfaces, teal accent, green/amber/red status. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0B0F12"/>
    <SolidColorBrush x:Key="Rail" Color="#080B0D"/>
    <SolidColorBrush x:Key="Surface" Color="#121A1F"/>
    <SolidColorBrush x:Key="Surface2" Color="#1A242B"/>
    <SolidColorBrush x:Key="Hover" Color="#22303A"/>
    <SolidColorBrush x:Key="Line" Color="#26343D"/>
    <SolidColorBrush x:Key="Text" Color="#E3EAEE"/>
    <SolidColorBrush x:Key="TextDim" Color="#8FA1AC"/>
    <SolidColorBrush x:Key="Accent" Color="#14B8A6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AccentText" Color="#04211E"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#0F3B37"/>
    <SolidColorBrush x:Key="Pass" Color="#22C55E"/>
    <SolidColorBrush x:Key="PassSoft" Color="#0E2E1C"/>
    <SolidColorBrush x:Key="Warn" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#3A2A0A"/>
    <SolidColorBrush x:Key="Fail" Color="#EF4444"/>
    <SolidColorBrush x:Key="FailSoft" Color="#3B1416"/>
    <SolidColorBrush x:Key="Neutral" Color="#64748B"/>
    <SolidColorBrush x:Key="NeutralSoft" Color="#1E2830"/>
    <SolidColorBrush x:Key="Selection" Color="#123C38"/>
</ResourceDictionary>
